<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PVS-Studio Spider — C/C++ analysis reports</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    margin: 0; color: #e6e6e6; background: #101418;
    display: flex; height: 100vh;
  }
  aside {
    width: 310px; min-width: 310px; overflow-y: auto;
    background: #0b0e12; border-right: 1px solid #2a3140;
    padding: 1rem 0.75rem;
  }
  aside h1 { font-size: 1.05rem; margin: 0 0 .25rem; }
  aside .meta { color: #9aa4b2; font-size: .78rem; margin: 0 0 .6rem; line-height: 1.4; }
  .sysdash {
    display: flex; flex-direction: column; gap: .25rem;
    background: #171d26; border: 1px solid #2a3140; border-radius: 8px;
    padding: .4rem .55rem; margin-bottom: .6rem; font-size: .72rem;
  }
  .sys-row { display: flex; align-items: center; gap: .4rem; }
  .sys-label { color: #9aa4b2; min-width: 2.2em; }
  .sys-bar { flex: 1; height: 5px; background: #1c2533; border-radius: 3px; overflow: hidden; }
  .sys-bar > div { height: 100%; background: #3b82c4; width: 0; transition: width .4s; }
  #cpufill { background: #34d399; }
  .sys-val { color: #e6e6e6; font-variant-numeric: tabular-nums; min-width: 5.5em; text-align: right; }
  .controls { display: flex; flex-direction: column; gap: .45rem; margin-bottom: .7rem; }
  #search, #filter {
    width: 100%; padding: .45rem .6rem; font-size: .85rem; color: #e6e6e6;
    background: #171d26; border: 1px solid #2a3140; border-radius: 8px; outline: none;
  }
  #search:focus, #filter:focus { border-color: #3b82c4; }
  .overview { margin: 0 0 1rem; }
  .bar { height: 6px; background: #1c2533; border-radius: 4px; overflow: hidden; }
  .bar > div { height: 100%; background: #3b82c4; width: 0; transition: width .4s; }
  .ov-text { color: #9aa4b2; font-size: .75rem; margin-top: .3rem; }
  nav { display: flex; flex-direction: column; gap: .12rem; }
  .project {
    display: block; position: relative; padding: .3rem .55rem; border-radius: 8px;
    border: 1px solid transparent; color: inherit; text-decoration: none;
  }
  .project:hover { background: #171d26; }
  .project.active { background: #1c2533; border-color: #3b82c4; }
  .project.done { cursor: pointer; }
  .project .repo-link {
    position: absolute; top: .3rem; right: .45rem; color: #7d8794;
    display: inline-flex; padding: .1rem; border-radius: 6px; line-height: 0;
  }
  .project .repo-link:hover { color: #e6e6e6; background: #171d26; }
  .project .name { font-weight: 600; padding-right: 1.5rem; }
  .project .desc { color: #9aa4b2; font-size: .78rem; margin-top: .05rem; }
  .project .met { color: #7d8794; font-size: .72rem; margin-top: .1rem;
    font-variant-numeric: tabular-nums; }
  .project .foot { display: flex; align-items: center; gap: .5rem; margin-top: .2rem; }
  .project .commit { font-family: ui-monospace, monospace; font-size: .72rem; color: #9aa4b2; }
  .project .state { font-size: .72rem; margin-left: auto; color: #9aa4b2; }
  .project.inprogress .state { color: #7dd3fc; }
  .project.failed .state { color: #f87171; }
  .project.done .state { color: #34d399; }
  .project.pending { opacity: .55; }
  .project.skipped { opacity: .45; }
  .badges { margin-top: .2rem; display: flex; gap: .35rem; flex-wrap: wrap; }
  .badge { display: inline-block; min-width: 2em; text-align: center; padding: .05rem .35rem;
    border-radius: 6px; font-size: .75rem; font-variant-numeric: tabular-nums; }
  .b-high { background: #7f1d1d; color: #fecaca; }
  .b-med  { background: #78350f; color: #fed7aa; }
  .b-low  { background: #1e3a8a; color: #bfdbfe; }
  .b-total{ background: #134e4a; color: #99f6e4; }
  .spinner {
    display: inline-block; width: .7rem; height: .7rem; border-radius: 50%;
    border: 2px solid #3b82c4; border-top-color: transparent;
    animation: spin .8s linear infinite; vertical-align: -1px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  #welcome { margin: auto; max-width: 480px; text-align: center; color: #9aa4b2; padding: 2rem; }
  #welcome code { background: #1c2533; padding: .1rem .35rem; border-radius: 4px; }
  #frame { flex: 1; width: 100%; border: 0; background: #fff; display: none; }
  #hint { color: #9aa4b2; font-size: .8rem; padding: .5rem 1rem; border-bottom: 1px solid #2a3140; }
</style>
</head>
<body>
<aside>
  <div class="sysdash">
    <div class="sys-row" title="Free disk space on the server">
      <span class="sys-label">disk</span>
      <div class="sys-bar"><div id="diskfill"></div></div>
      <span class="sys-val" id="diskval">—</span>
    </div>
    <div class="sys-row" title="Current CPU load">
      <span class="sys-label">cpu</span>
      <div class="sys-bar"><div id="cpufill"></div></div>
      <span class="sys-val" id="cpuval">—</span>
    </div>
  </div>
  <h1>PVS-Studio Spider</h1>
  <p class="meta">
    Static analysis of open-source C/C++ projects with
    <a href="https://pvs-studio.com/" style="color:#7dd3fc;">PVS-Studio</a>.
  </p>
  <div class="controls">
    <input id="search" type="search" placeholder="Search projects…" autocomplete="off">
    <select id="filter">
      <option value="all">All</option>
      <option value="active">In progress</option>
      <option value="done">Analyzed</option>
      <option value="failed">Failed</option>
      <option value="queued">Queued</option>
    </select>
  </div>
  <div class="overview">
    <div class="bar"><div id="barfill"></div></div>
    <div class="ov-text" id="ovtext">loading…</div>
  </div>
  <nav id="projects"></nav>
</aside>
<main>
  <div id="hint">Select a project in the sidebar to view its report.</div>
  <div id="welcome">
    No reports yet.<br><br>
    Run <code>docker compose run --rm spider analyze</code> to start, or wait for a
    running analysis — this page updates automatically.
  </div>
  <iframe id="frame"></iframe>
</main>
<script>
  var nav = document.getElementById('projects');
  var frame = document.getElementById('frame');
  var welcome = document.getElementById('welcome');
  var barfill = document.getElementById('barfill');
  var ovtext = document.getElementById('ovtext');
  var hint = document.getElementById('hint');
  var search = document.getElementById('search');
  var filter = document.getElementById('filter');
  var diskfill = document.getElementById('diskfill');
  var diskval = document.getElementById('diskval');
  var cpufill = document.getElementById('cpufill');
  var cpuval = document.getElementById('cpuval');
  var selected = null;
  var lastData = null;
  var lastSig = null;
  var metricsMap = {};
  var initialSlug = decodeURIComponent((location.hash || '').replace(/^#\/?/, ''));

  var ACTIVE = ['cloning', 'building', 'analyzing', 'converting'];
  var STATE_RANK = { cloning: 0, building: 0, analyzing: 0, converting: 0,
                     done: 1, failed: 2, pending: 3, skipped: 4 };

  function fmtBytes(b) {
    if (!b) return '';
    var u = ['B', 'KB', 'MB', 'GB', 'TB'], i = 0;
    while (b >= 1024 && i < u.length - 1) { b /= 1024; i++; }
    return (i ? b.toFixed(1) : b) + ' ' + u[i];
  }

  function fmtTime(s) {
    if (s == null) return '';
    s = Math.round(s);
    if (s >= 3600) return Math.floor(s / 3600) + 'h ' + Math.floor((s % 3600) / 60) + 'm';
    if (s >= 60) return Math.floor(s / 60) + 'm ' + (s % 60) + 's';
    return s + 's';
  }

  function openReport(slug, report) {
    if (!report) return;
    selected = slug;
    history.replaceState(null, '', '#' + slug);
    document.title = slug + ' — PVS-Studio Spider';
    frame.src = slug + '/' + report;
    frame.style.display = 'block';
    welcome.style.display = 'none';
    hint.style.display = 'block';
    document.querySelectorAll('.project').forEach(function (node) {
      node.classList.toggle('active', node.getAttribute('data-slug') === slug);
    });
  }

  function stateMatch(state, f) {
    if (f === 'active') return ACTIVE.indexOf(state) >= 0;
    if (f === 'done') return state === 'done';
    if (f === 'failed') return state === 'failed';
    if (f === 'queued') return state === 'pending';
    return true;
  }

  function itemHtml(p) {
    var esc = function (s) { return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;'); };
    var repo = p.repo ? '<a class="repo-link" href="' + esc(p.repo) +
      '" target="_blank" rel="noopener" title="' + esc(p.repo) +
      '" aria-label="Repository"><svg viewBox="0 0 16 16" width="14" height="14" ' +
      'fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59' +
      '.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23' +
      '-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87' +
      '.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59' +
      '.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36' +
      '.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15' +
      ' 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15' +
      '.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>' : '';
    var badges = '';
    if (p.stats) {
      var lv = p.stats.levels || {};
      badges =
        '<span class="badge b-total">' + p.stats.total + '</span>' +
        '<span class="badge b-high">H ' + lv.High + '</span>' +
        '<span class="badge b-med">M ' + lv.Medium + '</span>' +
        '<span class="badge b-low">L ' + lv.Low + '</span>';
    }
    var stateHtml;
    if (p.state === 'done') stateHtml = '<span class="state">analyzed</span>';
    else if (p.state === 'failed') stateHtml = '<span class="state" title="' + p.message.replace(/"/g, '&quot;') + '">failed</span>';
    else if (p.state === 'pending') stateHtml = '<span class="state">queued</span>';
    else if (p.state === 'skipped') stateHtml = '<span class="state">skipped</span>';
    else stateHtml = '<span class="spinner"></span> <span class="state">' + (p.message || p.state) + '</span>';
    var met = metricsMap[p.slug] || {};
    var metTitle = 'CPU ' + fmtTime(met.cpu_sec) + ' · total ' + fmtTime(met.wall_sec) +
      (met.clone_sec ? ' · clone ' + fmtTime(met.clone_sec) : '') +
      (met.build_sec ? ' · build ' + fmtTime(met.build_sec) : '') +
      (met.analyze_sec ? ' · pvs ' + fmtTime(met.analyze_sec) : '') +
      (met.convert_sec ? ' · convert ' + fmtTime(met.convert_sec) : '');
    var metHtml = (met.disk_bytes || met.build_sec || met.analyze_sec || met.cpu_sec || met.wall_sec)
      ? '<div class="met" title="' + metTitle + '">' + fmtBytes(met.disk_bytes) +
        (met.build_sec ? ' · build ' + fmtTime(met.build_sec) : '') +
        (met.analyze_sec ? ' · pvs ' + fmtTime(met.analyze_sec) : '') +
        ' · total ' + fmtTime(met.wall_sec) + '</div>' : '';
    return repo +
      '<div class="name">' + p.name + '</div>' +
      (p.description ? '<div class="desc">' + p.description + '</div>' : '') +
      badges +
      metHtml +
      '<div class="foot"><span class="commit">' + p.ref + ' @ ' + (p.commit || '—') + '</span>' + stateHtml + '</div>';
  }

  function render(data) {
    lastData = data;
    var projects = data && data.projects ? data.projects : {};
    var slugs = Object.keys(projects);
    if (!slugs.length) return;

    var total = slugs.length, done = 0;
    slugs.forEach(function (slug) {
      if (projects[slug].state === 'done') done++;
    });
    barfill.style.width = total ? Math.round(done / total * 100) + '%' : '0%';
    ovtext.textContent = done + '/' + total + ' projects analyzed';

    var q = search.value.toLowerCase().trim();
    var f = filter.value;
    var items = slugs
      .filter(function (slug) {
        var p = projects[slug];
        if (!stateMatch(p.state, f)) return false;
        if (q && (p.name + ' ' + (p.description || '')).toLowerCase().indexOf(q) < 0) return false;
        return true;
      })
      .sort(function (a, b) {
        return STATE_RANK[projects[a].state] - STATE_RANK[projects[b].state];
      });

    var sig = items.map(function (s) {
      var p = projects[s], m = metricsMap[s] || {};
      return s + '|' + p.state + '|' + (p.stats ? p.stats.total : '-') + '|' + (p.commit || '') +
        '|' + (m.disk_bytes || '') + '|' + (m.cpu_sec || '');
    }).join('~');
    if (sig === lastSig) return;
    lastSig = sig;

    nav.innerHTML = '';
    items.forEach(function (slug) {
      var p = projects[slug];
      var el = document.createElement('div');
      el.className = 'project ' + p.state + (slug === selected ? ' active' : '');
      el.setAttribute('data-slug', slug);
      el.innerHTML = itemHtml(p);
      if (p.state === 'done' && p.report) {
        el.addEventListener('click', function (e) {
          if (e.target.closest('.repo-link')) return;
          openReport(slug, p.report);
        });
      }
      nav.appendChild(el);
    });

    if (selected === null && initialSlug && projects[initialSlug] &&
        projects[initialSlug].state === 'done' && projects[initialSlug].report) {
      openReport(initialSlug, projects[initialSlug].report);
    } else if (selected && projects[selected] && projects[selected].state === 'done' && projects[selected].report) {
      frame.src = selected + '/' + projects[selected].report;
    }
  }

  function renderSys(s) {
    if (!s) return;
    if (s.disk_total) {
      var pct = Math.round(s.disk_free / s.disk_total * 100);
      diskfill.style.width = pct + '%';
      diskval.textContent = fmtBytes(s.disk_free) + ' free';
    }
    if (s.cpu_percent != null) {
      cpufill.style.width = Math.min(100, s.cpu_percent) + '%';
      cpuval.textContent = Math.round(s.cpu_percent) + '%';
    }
  }

  function poll() {
    Promise.all([
      fetch('status.json?t=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; }),
      fetch('metrics.json?t=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; }),
      fetch('server.json?t=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
    ]).then(function (res) {
      metricsMap = res[1] || {};
      renderSys(res[2]);
      render(res[0]);
    }).catch(function () {});
  }

  search.addEventListener('input', function () { lastSig = null; render(lastData); });
  filter.addEventListener('change', function () { lastSig = null; render(lastData); });

  poll();
  setInterval(poll, 3000);
</script>
</body>
</html>
