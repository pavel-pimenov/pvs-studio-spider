# --- PVS-Studio license ------------------------------------------------------
# PVS-Studio is free for open-source projects.
# Apply for a license: https://pvs-studio.com/en/order/open-source-license/
# After approval you receive a username (name) and a license key.
#
# If you instead have a license file (*.lic), copy it into the repo and set:
#   PVS_STUDIO_LICENSE=./PVS-Studio.lic

PVS_USERNAME=your_name
PVS_KEY=your_key

# --- GitHub (optional) -------------------------------------------------------
# A token raises the API rate limit for the `discover` command.
GITHUB_TOKEN=

# --- Report serving ----------------------------------------------------------
# Reports are written here and served by the system web server (lighttpd
# docroot /var/www) at https://www.fly-server.ru/pvs-studio/
SPIDER_REPORTS_DIR=/var/www/pvs-studio
# Public base URL used in generated shareable links (set to your host/IP/domain).
SPIDER_BASE_URL=https://www.fly-server.ru/pvs-studio

# --- Analysis -----------------------------------------------------------------
# How many projects to build/analyze concurrently (default: 1).
# Also settable in projects.yaml via `parallel:`.
SPIDER_PARALLEL=2
